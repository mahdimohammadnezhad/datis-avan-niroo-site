# Security hardening for Apache / LiteSpeed hosting (cPanel, DirectAdmin, ...).
# Upload the CONTENTS of the site/ folder only — never the repository root (.git).

# No directory listings
Options -Indexes

AddDefaultCharset UTF-8
AddType font/woff2 .woff2

# Never serve dotfiles or internal notes
<FilesMatch "(^\.|\.(md|bak|old|orig|log)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Only this site's own files may run or load. If you set SITE.formEndpoint in
  # assets/js/data.js, add that https origin to connect-src below.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By

  # HSTS: only sent over HTTPS. Enable after the SSL certificate works on every page.
  <If "%{HTTPS} == 'on'">
    Header always set Strict-Transport-Security "max-age=31536000"
  </If>
</IfModule>

# Redirect HTTP to HTTPS (uncomment once SSL is active)
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
